# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Only NEXT_PUBLIC_* vars reach the browser.
# ─────────────────────────────────────────────────────────────

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Full access — keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Phone OTP ----
# Supabase Auth sends the OTP SMS via a provider you configure in
# Dashboard -> Authentication -> Providers -> Phone (MSG91 / Twilio / etc.).
# If you use MSG91 directly instead of Supabase's SMS, add its keys here:
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# ---- Razorpay ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---- Cal.com ----
NEXT_PUBLIC_CALCOM_LINK=your-team/consultation

# ---- Google Analytics 4 ----
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ---- PostHog ----
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Bunny Stream (large video hosting) ----
# Create a Stream library at dash.bunny.net -> Stream. From the library:
#   Library ID (number), and the API Key (library-level, keep secret).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Public values used only for the player embed (safe in the browser):
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
